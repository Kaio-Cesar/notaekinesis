{
  "name": "@notaekinesis/server",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test ../tests",
    "dev:login": "bun --env-file=../.env scripts/dev-login.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.17",
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.31"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2"
  }
}
