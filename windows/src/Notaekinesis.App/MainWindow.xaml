<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Notaekinesis.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Notaekinesis.App.Controls"
    xmlns:vm="using:Notaekinesis.App.ViewModels"
    Title="notaekinesis">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="notaekinesis">
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="220"
                    MaxWidth="420"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    PlaceholderText="Search"
                    QueryIcon="Find"
                    TextChanged="OnSearchChanged"
                    Visibility="Collapsed" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,4,0">
                    <FontIcon
                        x:Name="SyncIcon"
                        FontSize="14"
                        Glyph="&#xE895;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="AccountButton"
                        Padding="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Account">
                        <PersonPicture x:Name="Avatar" Width="28" Height="28" />
                        <Button.Flyout>
                            <MenuFlyout Opening="OnAccountMenuOpening" Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="AccountName" IsEnabled="False" />
                                <MenuFlyoutItem x:Name="ServerName" IsEnabled="False" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem Text="Drop edge">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE89F;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <RadioMenuFlyoutItem x:Name="EdgeRight" Click="OnDropEdge" GroupName="edge" Tag="right" Text="Right edge" />
                                    <RadioMenuFlyoutItem x:Name="EdgeLeft" Click="OnDropEdge" GroupName="edge" Tag="left" Text="Left edge" />
                                    <RadioMenuFlyoutItem x:Name="EdgeOff" Click="OnDropEdge" GroupName="edge" Tag="off" Text="Off" />
                                </MenuFlyoutSubItem>
                                <ToggleMenuFlyoutItem x:Name="StartupToggle" Click="OnStartupToggle" Text="Start with Windows" />
                                <MenuFlyoutItem Text="Sync now" Click="OnSyncNow">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE895;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Sign out" Click="OnSignOut">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF3B1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Sign in -->
        <ScrollViewer x:Name="SignInPanel" Grid.Row="1" Visibility="Collapsed">
            <StackPanel MaxWidth="380" Margin="24" VerticalAlignment="Center" Spacing="16">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sign in" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Enter the address of your notaekinesis server. You'll sign in with your organization's account in the browser."
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="ServerBox"
                    Header="Server"
                    InputScope="Url"
                    KeyDown="OnServerKeyDown"
                    PlaceholderText="notes.example.com" />
                <InfoBar x:Name="SignInError" IsClosable="False" Severity="Error" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SignInButton" Click="OnSignIn" Content="Sign in" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="CancelSignInButton" Click="OnCancelSignIn" Content="Cancel" Visibility="Collapsed" />
                    <ProgressRing x:Name="SignInProgress" Width="20" Height="20" IsActive="False" />
                </StackPanel>
                <TextBlock
                    x:Name="SignInHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Finish signing in in your browser…"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- Notes -->
        <Grid x:Name="FeedPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Margin="16,8,16,8"
                Padding="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="4"
                CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="Composer"
                    MaxHeight="240"
                    AcceptsReturn="True"
                    BorderThickness="0"
                    Background="Transparent"
                    PlaceholderText="Write a note or paste a link… #tags"
                    PreviewKeyDown="OnComposerKeyDown"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="OnSave"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="Save"
                    ToolTipService.ToolTip="Save (Enter)">
                    <FontIcon FontSize="14" Glyph="&#xE724;" />
                </Button>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                Margin="16,0,16,4"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel x:Name="FilterBar" Orientation="Horizontal" Spacing="6" Padding="0,0,0,6">
                    <ToggleButton x:Name="ArchiveToggle" Click="OnArchiveToggle" ToolTipService.ToolTip="Show archived">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE7B8;" />
                            <TextBlock Text="Archive" />
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel x:Name="TagBar" Orientation="Horizontal" Spacing="6" />
                </StackPanel>
            </ScrollViewer>

            <InfoBar
                x:Name="UndoBar"
                Grid.Row="2"
                Margin="16,0,16,8"
                IsOpen="False"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Click="OnUndo" Content="Undo" />
                </InfoBar.ActionButton>
            </InfoBar>

            <ListView
                x:Name="Feed"
                Grid.Row="3"
                Padding="8,0,8,16"
                SelectionMode="None"
                IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemViewModel">
                        <Grid
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ContextRequested="OnCardContextRequested"
                            CornerRadius="8"
                            DoubleTapped="OnCardDoubleTapped"
                            Tag="{x:Bind}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <Image
                                    MaxHeight="360"
                                    HorizontalAlignment="Left"
                                    Source="{x:Bind Image, Mode=OneWay}"
                                    Stretch="Uniform"
                                    Visibility="{x:Bind IsImage}" />
                                <Button
                                    Padding="8,6"
                                    HorizontalAlignment="Left"
                                    Click="OnOpenFile"
                                    Tag="{x:Bind}"
                                    Visibility="{x:Bind IsOtherFile}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE8A5;" />
                                        <TextBlock Text="{x:Bind FileLabel}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                                <HyperlinkButton
                                    Padding="0"
                                    Click="OnOpenLink"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind Item.Url}"
                                    Visibility="{x:Bind HasLink}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE774;" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind LinkTitle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </HyperlinkButton>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind Item.Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasDescription}" />
                                <controls:MarkdownView
                                    Markdown="{x:Bind Item.Text}"
                                    MaxLines="14"
                                    Visibility="{x:Bind HasText}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontSize="12" Glyph="&#xE718;" Visibility="{x:Bind IsPinned}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind When}"
                                        ToolTipService.ToolTip="{x:Bind WhenFull}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{x:Bind TagsText}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind HasTags}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Margin="8,-4,-8,0"
                                Padding="6"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnMore"
                                Tag="{x:Bind}"
                                AutomationProperties.Name="More actions">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyText"
                Grid.Row="3"
                Margin="24"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
