<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sync engine, local database and server API. No UI, so it can be tested on its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Notaekinesis.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Notaekinesis.Core.Tests" />
  </ItemGroup>
</Project>
