# Copy to .env at the repo root. `bun run dev` loads it for the server.

# Public URL the browser uses. In development that's the Vite dev server,
# which proxies /api to the Bun server, so cookies and OIDC redirects stay on one origin.
PUBLIC_URL=http://localhost:5173
PORT=3000
# Where the database and uploaded files live. Defaults to ./data next to the server
# (server/data in development). Leave it unset for Docker: the image uses its /data volume.
# DATA_DIR=./data

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# OIDC (Authentik, Authelia, Keycloak, Pocket ID, ...).
# Register a confidential client with redirect URI:
#   ${PUBLIC_URL}/api/auth/callback/${OIDC_PROVIDER_ID}
OIDC_PROVIDER_ID=homelab
OIDC_DISCOVERY_URL=https://auth.example.lan/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid,profile,email,groups
# Optional: comma-separated groups allowed to sign in (empty = anyone the IdP lets through).
OIDC_ALLOWED_GROUPS=

# Production only: folder with the built web app, served at /
# WEB_DIST=../web/dist

# Largest upload accepted, in MB (images, videos, PDFs). Files are stored in DATA_DIR/files.
# If a reverse proxy sits in front, raise its body limit too (e.g. nginx client_max_body_size).
MAX_UPLOAD_MB=100
